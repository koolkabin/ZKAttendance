{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=ZKAttendanceWebDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },

  "JwtSettings": {
    "Key": "CHANGE_THIS_IN_DEVELOPMENT",
    "Issuer": "ZKAttendance", 
    "Audience": "ZKAttendanceClients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },

  "OrganizationSettings": {
    "OrganizationName": "Your Organization Pvt. Ltd.",
    "Country": "NP",
    "TimeZone": "Nepal Standard Time",
    "Currency": "NPR"
  },

  "NepaliCalendarSettings": {
    "UseNepaliDates": true,
    "DateFormat": "yyyy-MM-dd",
    "ShowGregorianAlongside": true,
    "WeeklyOffDay": "Saturday",
    "FiscalYearStartMonth": 4
  },

  "BranchConfiguration": {
    "BranchId": 1,
    "BranchCode": "BR001",
    "BranchName": "Head Office"
  },

  "SyncConfiguration": {
    "EnableAutoSync": false,
    "_comment_EnableAutoSync": "false = no automatic 5-minute pull. Punches only arrive when you press Sync on a device, or via POST /api/Attendance/manual. Turn on once a real device is registered and its users are mapped in EmployeeDevices.",
    "SyncIntervalMinutes": 5,
    "MaxRetryAttempts": 3,
    "RetryIntervalMinutes": 5,
    "MinimumPunchIntervalSeconds": 60,
    "ClockDriftToleranceSeconds": 60,
    "OverlapWindowDays": 2,
    "UseFakeDeviceReader": false,
    "DeviceProtocol": "Tcp",
    "DeviceCommPassword": 0,
    "DeviceTimeoutMs": 5000
  },

  "DeviceMonitorConfiguration": {
    "CheckIntervalMinutes": 1,
    "PingTimeoutMs": 2000,
    "TcpTimeoutMs": 3000
  },

  "HangfireSettings": {
    "WorkerCount": 4,
    "DashboardToken": ""
  },

  "SmtpSettings": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "notifications@zkattendance.local",
    "FromName": "ZKAttendance System",
    "EnableSsl": true
  },

  "LateNotificationSettings": {
    "Enabled": true,
    "CronExpression": "*/15 * * * *"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}